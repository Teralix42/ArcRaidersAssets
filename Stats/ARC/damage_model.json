  "formulas": {
    "basic_damage_taken_multiplier": "1 - resistance",
    "physical_normal_sturdy_fragile": "physical_damage_per_projectile * (1 - physical_resistance)",
    "physical_armor": "physical_damage_per_projectile * clamp((1 - physical_resistance) * weapon_arc_armor_damage_multiplier, 0, 1)",
    "physical_weakpoint_and_critical": "physical_damage_per_projectile * (1 - physical_resistance) * weapon_arc_weakpoint_damage_multiplier",
    "non_physical_damage": "input_damage_of_that_type * (1 - resistance_of_that_type)",
    "explosive_flag_disabled": "explosive_damage_multiplier = (1 - physical_resistance) * 2",
    "explosive_flag_enabled": "explosive_damage_multiplier = (1 - 0.4 * physical_resistance) * 1.6",
    "distance_and_area": "Multiply the direct stage by the weapon distance factor and the attack's affected-degree/exposure factor. A spherical target routine already includes radial falloff in its affected degree; do not apply that radial curve twice.",
    "sphere_radial_curve_input": "clamp(distance_cm / configured_radius_cm, 0, 1)",
    "sphere_radial_curve_output": "clamp(radial_curve(normalized_distance), 0, 1)",
    "sphere_radial_without_curve": "1 - clamp(distance_cm / configured_radius_cm, 0, 1)"
  },
  "explosive_feature_flag": {
